rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User data subtree — only the owner can read/write
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // More granular validation per collection
    match /users/{uid}/settings {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.paydayDay is int
        && request.resource.data.paydayDay >= 1
        && request.resource.data.paydayDay <= 31
        && request.resource.data.currency == 'PLN';
    }

    match /users/{uid}/transactions/{txId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.amount is int
        && request.resource.data.amount >= 0;
    }
  }
}
